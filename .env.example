# Runtime database URL — Supabase transaction pooler (PgBouncer)
# For Vercel/serverless production, use connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct / session pooler database URL — used by Prisma CLI migrations
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js v5 session encryption secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-32-byte-random-secret"

# Optional — UploadThing token for organizer verification document uploads
# When omitted, verification files are stored locally in .uploads/ during development
UPLOADTHING_TOKEN=""
